# Шаблон production .env для сервера
# Скопировать в корень проекта как .env и заполнить реальные значения.
# Секреты: JWT_SECRET -> openssl rand -hex 32

APP_NAME=BarberSaaS API
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# Абсолютный путь к SQLite (4 слэша после sqlite+aiosqlite:)
DATABASE_URL=sqlite+aiosqlite:////opt/barbersaas/backend/barbersaas.db

# Нужен только для Telegram-напоминаний (celery). Иначе можно оставить как есть.
REDIS_URL=redis://localhost:6379/0

# ОБЯЗАТЕЛЬНО заменить: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60

# ОБЯЗАТЕЛЬНО: в production API не стартует без реального токена
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

# Домен, по которому открыт Mini App (HTTPS обязателен)
TELEGRAM_WEBAPP_URL=https://your-domain.example

# В production всегда false — иначе dev-вход без авторизации
ALLOW_DEV_AUTH=false

# Домен Mini App
CORS_ORIGINS=https://your-domain.example

DEFAULT_TIMEZONE=Europe/Moscow
TELEGRAM_INIT_DATA_TTL_SECONDS=86400
REMINDER_MINUTES_BEFORE=120
